# Sanity.io Configuration
# Create a project at https://www.sanity.io/manage and fill in these values
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-03-14"

# Site URL — the single source of truth for the site's own address. Read via
# lib/site-url.ts; never write a host into a string. Sitemaps, canonicals, OG
# images, JSON-LD, every link inside an email, and the copyable embed snippet
# all derive from it. Cutover to workagedleads.com happened 2026-08-03, in the
# same deploy as NOINDEX_HOSTS="".
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Reader-facing contact address published on /privacy, /terms, /contact and
# /editorial-process. Deliberately NOT derived from NEXT_PUBLIC_SITE_URL: a
# mailbox is not a DNS record, and flipping the site URL must not repoint the
# legal pages at an address nobody has created yet. Set this once the mailbox
# on the new domain exists and is monitored. Defaults to bill@workagedleads.com.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Hosts to suppress from indexing. Empty since the 2026-08-03 cutover; the
# mechanism in lib/soft-launch.ts is intact, so set it to re-suppress a host.
NOINDEX_HOSTS=""

# Google Analytics 4 (measurement ID from GA4 Admin > Data Streams, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Google Tag Manager (optional — create container at https://tagmanager.google.com)
# Not set in production: GA4 loads directly, so no container is in play.
NEXT_PUBLIC_GTM_ID=""

# Search Engine Verification (optional)
# Not set in production: both properties are verified by DNS, so these meta
# tags are unnecessary. Keep them for a host that cannot verify by DNS.
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# Email / Newsletter (optional — sign up at https://resend.com)
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_FROM_EMAIL=""

# Weekly Content Cron Job
# Sanity write token for publishing content (https://www.sanity.io/manage)
SANITY_API_TOKEN=""
# Secret to authenticate Vercel cron job requests
CRON_SECRET=""
# GitHub personal access token for committing weekly reports (needs repo:contents write)
GITHUB_TOKEN=""
# GitHub repository in owner/repo format
GITHUB_REPO=""
# Branch to commit reports to (defaults to "main")
GITHUB_BRANCH=""

# On-demand cache purge for Sanity content (app/api/revalidate). Point a Sanity
# webhook at POST /api/revalidate with `Authorization: Bearer <this>`, or the
# site serves prerendered pages until their staleness window expires. Falls
# back to CRON_SECRET when unset, so the route works without new Vercel config.
SANITY_REVALIDATE_SECRET=""

# Google APIs for the performance/SEO crons — Workload Identity Federation.
# There is no service-account key file and no GOOGLE_PRIVATE_KEY: Vercel's OIDC
# token is exchanged for short-lived credentials that impersonate the
# brsg-analytics-reader service account. See lib/cron/google-auth.ts.
# Grant that service account Viewer on the GA4 and Search Console properties.
GOOGLE_WORKLOAD_IDENTITY_AUDIENCE=""
GOOGLE_SERVICE_ACCOUNT_IMPERSONATION_URL=""
# GA4 property ID (numeric, find at Admin > Property > Property details)
GA4_PROPERTY_ID=""
# Google Search Console site URL (e.g., https://workagedleads.com)
GSC_SITE_URL=""
