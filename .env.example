# Sanity.io Configuration
# Create a project at https://www.sanity.io/manage and fill in these values
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-03-14"

# Site URL (used for sitemaps, canonical URLs, OG images)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Google Tag Manager (optional — create container at https://tagmanager.google.com)
NEXT_PUBLIC_GTM_ID=""

# Search Engine Verification (optional)
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# Email / Newsletter (optional — sign up at https://resend.com)
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_FROM_EMAIL=""
NEWSLETTER_SEND_SECRET=""

# Weekly Content Cron Job
# OpenAI API key for AI-powered content generation (https://platform.openai.com)
OPENAI_API_KEY=""
# Sanity write token for publishing content (https://www.sanity.io/manage)
SANITY_API_TOKEN=""
# Secret to authenticate Vercel cron job requests
CRON_SECRET=""
# GitHub personal access token for committing weekly reports (needs repo:contents write)
GITHUB_TOKEN=""
# GitHub repository in owner/repo format
GITHUB_REPO=""
# Branch to commit reports to (defaults to "main")
GITHUB_BRANCH=""

# Daily Performance Report — Google APIs
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Analytics Data API and Search Console API
# Grant the service account Viewer access to your GA4 property and GSC property
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
# GA4 property ID (numeric, find at Admin > Property > Property details)
GA4_PROPERTY_ID=""
# Google Search Console site URL (e.g., https://agedleadsales.com)
GSC_SITE_URL=""
