{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/weekly-content",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/cron/weekly-newsletter",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron/seo-audit",
      "schedule": "0 10 * * 3"
    },
    {
      "path": "/api/cron/daily-performance",
      "schedule": "0 12 * * *"
    }
  ]
}
